PROMPT = """Below is a timestamped transcript of a recording ({title}), one [H:MM:SS] per
sentence; it is a machine transcription, so names may be misheard.

Propose {n} clips, best first, each {lo}-{hi} seconds long (as long as the
moment needs, not all the same length), that work on their own without
context: provocative, funny, quotable, a strong claim or a sharp one-liner.
Skip pre-show and housekeeping, prefer a mix of speakers, start on the setup
and end right after the punchline. Leave out anything whose point rests on a
slur. A person will choose which of them get cut, so make each one clearly
different from the others.
{brief}
Answer one clip per line, exactly:
N | START H:MM:SS | END H:MM:SS | speaker | hook title (max 6 words) | until LASTWORD | what is said and why it works, one sentence
START is the stamp of the first sentence, END the stamp of the last sentence
included, LASTWORD the last word of that sentence (it pins the cut when two
sentences share a stamp).

{transcript}"""


def prompt(a):
    meta = os.path.join(a.dir, 'meta.tsv')
    title = open(meta).read().split('\t')[0] if os.path.exists(meta) else 'a recording'
    brief = a.brief or ''
    if a.brief_file:
        brief = open(a.brief_file).read().strip()
    if brief:
        brief = ('\nWhat the person is looking for, which matters more than the general\n'
                 'advice above:\n' + brief.strip() + '\n')
    print(PROMPT.format(title=title, n=a.n, lo=a.min, hi=a.max, brief=brief,
                        transcript=open(os.path.join(a.dir, 'transcript-ts.txt')).read()))


# --- cut ---------------------------------------------------------------------

# A caption's colour by who says it (ASS colours are blue-green-red): white,
# light blue, orange, green, pink. The word being said stays yellow.
SPEAKER_COLOURS = ['&HFFFFFF&', '&HFFD38F&', '&H6CB8FF&', '&H8CF1B9&', '&HE0A0FF&']
SAYING = '&H00E5FF&'


def speaker_colour(letter):
    return SPEAKER_COLOURS[(ord(letter) - 65) % len(SPEAKER_COLOURS)] if letter else SPEAKER_COLOURS[0]


def ass_colour(hexrgb):
    """'#FFAA00' (or 'ffaa00') as ASS writes it: '&H00AAFF&'; '' stays ''."""
    h = (hexrgb or '').strip().lstrip('#')
    if not h:
        return ''
    if not re.fullmatch(r'[0-9A-Fa-f]{6}', h):
        sys.exit(f'reelcut: {hexrgb!r} is not a colour; write it as #RRGGBB')
    return f'&H{h[4:6]}{h[2:4]}{h[0:2]}&'.upper()


# Where a person sits, as --speakers takes it ("A=Name@middle").
SIDES = {'left': 'left', 'right': 'right', 'middle': 'middle', 'center': 'middle', 'centre': 'middle'}


def side_person(people, side, W):
    """The person sitting on that side (left, middle, right), as an index in
    people; faces seen only now and then (a passer-by, a picture) left out."""
    if not people:
        return None
    most = len(people[0]['seen'])
    cand = [k for k in range(len(people)) if len(people[k]['seen']) >= 0.15 * most]
    by_x = sorted(cand, key=lambda k: people[k]['cx'])
    if side == 'left':
        return by_x[0]
    if side == 'right':
        return by_x[-1]
    inner = by_x[1:-1] or by_x
    return min(inner, key=lambda k: abs(people[k]['cx'] - W / 2))


