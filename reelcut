#!/usr/bin/env python3
"""reelcut: from a long video to short vertical reels with burned-in captions.

  reelcut fetch URL DIR             the audio and the video, with yt-dlp
  reelcut transcribe DIR            word-level transcript, with Parakeet
  reelcut prompt DIR                what to ask a model to pick the clips
  reelcut cut DIR CLIPS OUT         the reels, from a list of clips
  reelcut page OUT [--title T]      an index.html that plays them

DIR holds one recording: audio.*, video.mp4, and what transcribe writes
(words.json, transcript-ts.txt, transcript.txt). The steps are separate so a
person, or any model, can pick the clips between transcribe and cut.
"""
import argparse, glob, html, json, os, re, shutil, subprocess, sys
from concurrent.futures import ThreadPoolExecutor

MODEL = os.environ.get('REELCUT_MODEL', os.path.expanduser('~/.local/share/whisper/ggml-parakeet-tdt-0.6b-v3-q4_k.bin'))
PARAKEET = os.environ.get('REELCUT_PARAKEET', shutil.which('parakeet-cli') or os.path.expanduser('~/.local/bin/parakeet-cli'))
PIECE = 60  # seconds per transcription piece

FILLERS = {'um', 'umm', 'uh', 'uhh', 'uhm', 'er', 'erm', 'hmm', 'mm'}


def run(*a, **kw):
    return subprocess.run(a, check=True, **kw)


def write_json(path, data):
    """Written whole or not at all: transcribe and diarize can run side by
    side, and each may read what the other just wrote."""
    tmp = path + '.part'
    with open(tmp, 'w') as f:
        json.dump(data, f)
    os.replace(tmp, path)


def find(d, pattern):
    hits = sorted(glob.glob(os.path.join(d, pattern)))
    if not hits:
        sys.exit(f'reelcut: no {pattern} in {d}')
    return hits[0]


# --- fetch -------------------------------------------------------------------

def fetch(a):
    os.makedirs(a.dir, exist_ok=True)
    out = lambda name: os.path.join(a.dir, name + '.%(ext)s')
    run('yt-dlp', '-q', '--no-warnings', '-f', 'bestaudio', '-o', out('audio'),
        '--print-to-file', '%(title)s\t%(channel)s\t%(duration)s\t%(upload_date)s',
        os.path.join(a.dir, 'meta.tsv'), a.url)
    # Ranked, not filtered: up to 1080p by the shorter side (yt-dlp's res, so
    # a portrait 1080x1920 counts as 1080), then plain https over HLS, whose
    # small fragments come throttled (a 97-minute video at 300 KB/s, and as
    # 360p, under the old filter), then H.264.
    # A format YouTube lists can still answer 403 through the client yt-dlp
    # picked (1080p, on scribe's box, 2026-10-14): another client, and only
    # then less resolution.
    for extra in ([], ['--extractor-args', 'youtube:player_client=web_safari,mweb'],
                  ['-S', 'res:720,proto:https,vcodec:h264,ext:mp4']):
        sort = extra if extra[:1] == ['-S'] else ['-S', 'res:1080,proto:https,vcodec:h264,ext:mp4'] + extra
        for part in glob.glob(os.path.join(a.dir, 'video.*')):
            os.remove(part)  # a half download of another format is not resumed
        if subprocess.run(['yt-dlp', '-q', '--no-warnings', '-f', 'bv*', *sort, '--remux-video', 'mp4',
                           '-o', os.path.join(a.dir, 'video.%(ext)s'), a.url]).returncode == 0:
            break
        print('reelcut: that video download failed; trying another way', file=sys.stderr)
    else:
        sys.exit('reelcut: no video could be downloaded')
    print(open(os.path.join(a.dir, 'meta.tsv')).read().strip())


# --- transcribe --------------------------------------------------------------

def transcribe(a):
    d = a.dir
    p = os.path.join(d, 'p')
    os.makedirs(p, exist_ok=True)
    src = find(d, 'audio.*') if glob.glob(os.path.join(d, 'audio.*')) else find(d, 'video.*')
    run('ffmpeg', '-loglevel', 'error', '-y', '-i', src, '-vn', '-ac', '1', '-ar', '16000',
        '-f', 'segment', '-segment_time', str(PIECE), '-reset_timestamps', '1', os.path.join(p, '%04d.wav'))
    wavs = sorted(glob.glob(os.path.join(p, '*.wav')))
    cpus = os.cpu_count() or 4
    jobs = a.jobs or max(1, cpus // a.threads)

    def one(w):
        # The word timings come on stderr, with the model's own chatter; the
        # text alone is on stdout. Keep both.
        with open(w + '.ps', 'w') as f:
            subprocess.run([PARAKEET, '-m', MODEL, '-f', w, '-t', str(a.threads), '-ps'],
                           stdout=f, stderr=subprocess.STDOUT, check=True)
        return w

    print(f'{len(wavs)} pieces of {PIECE} s, {jobs} at a time, {a.threads} threads each', file=sys.stderr)
    with ThreadPoolExecutor(jobs) as ex:
        for i, _ in enumerate(ex.map(one, wavs), 1):
            print(f'\r{i}/{len(wavs)}', end='', file=sys.stderr)
    print(file=sys.stderr)
    words = parse_words(p)
    write_json(os.path.join(d, 'words.json'), [[round(s, 2), round(e, 2), w] for s, e, w in words])
    n = write_transcripts(d, words)
    print(f'{len(words)} words, {n} sentences: {d}/transcript-ts.txt')
    if os.path.exists(os.path.join(d, 'diarization.json')):
        label_words(d)  # diarize finished first: the words get their speakers now


def write_transcripts(d, words):
    """transcript-ts.txt (a stamp per sentence) and transcript.txt (a stamp
    per minute). Labelled words (diarize) put the sentence's speaker after
    the stamp: "[0:03:42] B: …", the speaker who said most of it."""
    sents = sentences(words)
    with open(os.path.join(d, 'transcript-ts.txt'), 'w') as f:
        for s in sents:
            who = f'{s[3]}: ' if s[3] else ''
            f.write(f'[{hms(s[0])}] {who}{s[2]}\n')
    with open(os.path.join(d, 'transcript.txt'), 'w') as f:
        minute, last = -1, None
        for s in sents:
            if int(s[0] // 60) != minute:
                minute = int(s[0] // 60)
                f.write(f'\n[{hms(s[0])}] ')
                last = None
            if s[3] and s[3] != last:
                f.write(f'{s[3]}: ')
                last = s[3]
            f.write(s[2] + ' ')
    return len(sents)


TOK = re.compile(r'word_start=(true|false) "(.*)"$')
TT = re.compile(r't0=\s*(\d+) t1=\s*(\d+)')


def parse_words(p):
    """Words with start and end in seconds. Parakeet's token times are in
    10 ms steps from the start of each piece."""
    words = []
    for f in sorted(glob.glob(os.path.join(p, '*.wav.ps'))):
        off = int(os.path.basename(f).split('.')[0]) * PIECE
        for line in open(f, errors='replace'):
            m, t = TOK.search(line), TT.search(line)
            if not (m and t):
                continue
            start, text = m.group(1) == 'true', m.group(2)
            t0, t1 = off + int(t.group(1)) / 100, off + int(t.group(2)) / 100
            piece = text.replace('▁', '')
            if (start or text.startswith('▁') or not words) and piece:
                words.append([t0, t1, piece])
            elif words:
                words[-1][1] = max(words[-1][1], t1)
                words[-1][2] += piece
    return words


def is_end(w):
    """A sentence ends at . ? !, but not at an initial like "H." or "L."."""
    return w.endswith(('.', '?', '!')) and not re.fullmatch(r'[A-Z]\.', w)


def sentences(words):
    """(start, end, text, speaker or None) per sentence; the speaker is who
    said most of its words, when the words are labelled (diarize)."""
    out, cur = [], []

    def close():
        spk = [x[3] for x in cur if len(x) > 3]
        who = max(set(spk), key=spk.count) if spk else None
        out.append((cur[0][0], cur[-1][1], ' '.join(x[2] for x in cur), who))
    for w in words:
        cur.append(w)
        if is_end(w[2]):
            close()
            cur = []
    if cur:
        close()
    return out


def hms(t):
    t = int(t)
    return f'{t // 3600}:{t % 3600 // 60:02d}:{t % 60:02d}'


def secs(s):
    h, m, x = (int(v) for v in s.strip().split(':'))
    return h * 3600 + m * 60 + x


# --- diarize -----------------------------------------------------------------

DIAR_SEG_URL = ('https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-segmentation-models/'
                'sherpa-onnx-pyannote-segmentation-3-0.tar.bz2')
DIAR_SEG_SHA256 = '220ad67ca923bef2fa91f2390c786097bf305bceb5e261d4af67b38e938e1079'  # its model.onnx
DIAR_EMB_URL = ('https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/'
                'nemo_en_titanet_small.onnx')
DIAR_EMB_SHA256 = 'ad4a1802485d8b34c722d2a9d04249662f2ece5d28a7a039063ca22f515a789e'


def diar_models():
    """pyannote segmentation 3.0 and TitaNet-small, as ONNX:
    $REELCUT_DIAR_SEG / $REELCUT_DIAR_EMB, or fetched once into
    ~/.cache/reelcut and checked."""
    import hashlib, io, tarfile, urllib.request
    cache = os.path.expanduser('~/.cache/reelcut')
    seg = os.environ.get('REELCUT_DIAR_SEG') or os.path.join(cache, 'pyannote-segmentation-3.onnx')
    emb = os.environ.get('REELCUT_DIAR_EMB') or os.path.join(cache, 'titanet-small.onnx')
    os.makedirs(cache, exist_ok=True)
    if not os.path.exists(seg):
        raw = urllib.request.urlopen(DIAR_SEG_URL, timeout=120).read()
        with tarfile.open(fileobj=io.BytesIO(raw), mode='r:bz2') as t:
            data = t.extractfile(next(m for m in t.getmembers() if m.name.endswith('/model.onnx'))).read()
        if hashlib.sha256(data).hexdigest() != DIAR_SEG_SHA256:
            sys.exit('reelcut: the segmentation model did not match its checksum')
        open(seg, 'wb').write(data)
    if not os.path.exists(emb):
        data = urllib.request.urlopen(DIAR_EMB_URL, timeout=120).read()
        if hashlib.sha256(data).hexdigest() != DIAR_EMB_SHA256:
            sys.exit('reelcut: the speaker embedding model did not match its checksum')
        open(emb, 'wb').write(data)
    return seg, emb


def diarize(a):
    """Who speaks when: every word in words.json gets a speaker (A, B, …, in
    the order they first speak), and the transcripts say who said each
    sentence. sherpa-onnx's offline diarization: pyannote finds the speech
    and its turns, TitaNet tells the voices apart. Give --speakers when you
    know how many people talk; without it they are counted by how alike the
    voices are (--threshold)."""
    import time
    import numpy as np
    import sherpa_onnx
    d = a.dir
    src = find(d, 'audio.*') if glob.glob(os.path.join(d, 'audio.*')) else find(d, 'video.*')
    pcm = subprocess.run(['ffmpeg', '-loglevel', 'error', '-i', src, '-vn', '-ac', '1', '-ar', '16000',
                          '-f', 's16le', '-'], capture_output=True, check=True).stdout
    audio = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768
    seg, emb = diar_models()
    # Four threads: as fast as eight or sixteen here (sherpa scales no
    # further; sixteen was slower), and the rest is left to transcribe.
    threads = a.threads or 4
    cfg = sherpa_onnx.OfflineSpeakerDiarizationConfig(
        segmentation=sherpa_onnx.OfflineSpeakerSegmentationModelConfig(
            pyannote=sherpa_onnx.OfflineSpeakerSegmentationPyannoteModelConfig(model=seg), num_threads=threads),
        embedding=sherpa_onnx.SpeakerEmbeddingExtractorConfig(model=emb, num_threads=threads),
        clustering=sherpa_onnx.FastClusteringConfig(num_clusters=a.speakers or -1, threshold=a.threshold),
        min_duration_on=0.3, min_duration_off=0.5)
    t = time.time()
    segs = [(x.start, x.end, x.speaker) for x in
            sherpa_onnx.OfflineSpeakerDiarization(cfg).process(audio).sort_by_start_time()]
    took = time.time() - t
    if not segs:
        sys.exit('reelcut: no speech found to tell speakers apart in')
    # Counted from the voices, a "speaker" with a few seconds in all is a
    # fragment of someone (a laugh, a cough, a moment off the microphone):
    # its stretches go to whoever speaks around them.
    if not a.speakers:
        talk = {}
        for s0, s1, sp in segs:
            talk[sp] = talk.get(sp, 0) + s1 - s0
        tiny = {sp for sp, v in talk.items() if v < max(5.0, 0.02 * sum(talk.values()))}
        if tiny and len(tiny) < len(talk):
            for k, (s0, s1, sp) in enumerate(segs):
                if sp in tiny:
                    near = [x for x in segs[k - 1::-1] + segs[k + 1:] if x[2] not in tiny] if k else \
                           [x for x in segs[k + 1:] if x[2] not in tiny]
                    if near:
                        segs[k] = (s0, s1, near[0][2])
    # Letters in the order people first speak: A opens the recording.
    order = {}
    for _, _, sp in segs:
        order.setdefault(sp, chr(65 + len(order)))
    write_json(os.path.join(d, 'diarization.json'),
               [[round(s0, 2), round(s1, 2), order[sp]] for s0, s1, sp in segs])
    dur = len(audio) / 16000
    talk = {}
    for s0, s1, sp in segs:
        talk[order[sp]] = talk.get(order[sp], 0) + s1 - s0
    print(f'{len(order)} speakers in {dur:.0f} s of audio, told apart in {took:.0f} s '
          f'({dur / max(took, 0.1):.0f}x real time): ' +
          ', '.join(f'{k} {v / 60:.1f} min' for k, v in sorted(talk.items())))
    if os.path.exists(os.path.join(d, 'words.json')):
        label_words(d)
        print(f'{d}/transcript-ts.txt now says who said each sentence ("[0:03:42] B: …")')
    else:
        print(f'saved in {d}/diarization.json; transcribe labels the words when it finishes')


def label_words(d):
    """Each word of words.json given the speaker of diarization.json whose
    turn it falls in (the nearest turn between them), and the transcripts
    written again with who said each sentence."""
    segs = json.load(open(os.path.join(d, 'diarization.json')))
    words = json.load(open(os.path.join(d, 'words.json')))
    out = []
    for w in words:
        mid = (w[0] + w[1]) / 2
        hit = [sp for s0, s1, sp in segs if s0 <= mid <= s1]
        if not hit:
            hit = [min(segs, key=lambda x: min(abs(x[0] - mid), abs(x[1] - mid)))[2]]
        out.append([w[0], w[1], w[2], hit[0]])
    write_json(os.path.join(d, 'words.json'), out)
    write_transcripts(d, out)


