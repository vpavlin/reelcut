def ts(t):
    return f'{int(t // 3600)}:{int(t % 3600 // 60):02d}:{t % 60:05.2f}'


def clip_lines(path):
    for line in open(path):
        parts = [p.strip() for p in line.split('|')]
        if len(parts) >= 5 and re.match(r'(CLIP\s*)?\d+$', parts[0], re.I):
            yield parts


# --- following the speaker (--frame speaker) --------------------------------

FACE_MODEL_URL = ('https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/'
                  'face_detection_yunet/face_detection_yunet_2023mar.onnx')
FACE_MODEL_SHA256 = '8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4'
FIT = ('split[bg{k}][fg{k}];'
       '[bg{k}]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,'
       'gblur=sigma=40,eq=brightness=-0.12[bg{k}b];'
       '[fg{k}]scale=1080:-2[fg{k}b];[bg{k}b][fg{k}b]overlay=(W-w)/2:(H-h)/2')


def face_model():
    """YuNet (OpenCV's face detector, 230 KB): $REELCUT_FACE_MODEL, or fetched
    once into ~/.cache/reelcut and checked."""
    p = os.environ.get('REELCUT_FACE_MODEL') or os.path.expanduser('~/.cache/reelcut/yunet.onnx')
    if not os.path.exists(p):
        import hashlib, urllib.request
        os.makedirs(os.path.dirname(p), exist_ok=True)
        data = urllib.request.urlopen(FACE_MODEL_URL, timeout=60).read()
        if hashlib.sha256(data).hexdigest() != FACE_MODEL_SHA256:
            sys.exit('reelcut: the face model did not match its checksum')
        open(p, 'wb').write(data)
    return p


def face_samples(video, t0, t1, fps=5.0):
    """Faces between t0 and t1, about fps times a second: (samples, tracks,
    W, H). A sample is (t, {track: (cx, activity, cy, face_h, face_w)},
    frame or None); a track is one face followed across samples. Activity is
    how much more the lower half of the face (mouth, jaw) changed than the
    upper since the last sample."""
    import cv2
    import numpy as np
    cap = cv2.VideoCapture(video)
    src_fps = cap.get(cv2.CAP_PROP_FPS) or 30
    W, H = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)), int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    sc = 640 / W
    det = cv2.FaceDetectorYN.create(face_model(), '', (640, int(H * sc)), 0.7, 0.3, 5000)
    cap.set(cv2.CAP_PROP_POS_MSEC, t0 * 1000)
    step, n = max(1, round(src_fps / fps)), 0
    tracks, samples, next_id = {}, [], 0
    while True:
        ok, frame = cap.read()
        if not ok:
            break
        t = t0 + n / src_fps
        n += 1
        if t > t1:
            break
        if (n - 1) % step:
            continue
        _, faces = det.detect(cv2.resize(frame, (640, int(H * sc))))
        faces = [] if faces is None else list(faces)
        if faces:  # a face far smaller than the largest is a picture on the wall
            big = max(f[2] for f in faces)
            faces = [f for f in faces if f[2] >= 0.5 * big]
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        seen = {}
        for f in faces:
            x, y, w, h = (f[:4] / sc).astype(int)
            cx = x + w / 2
            best, bd = None, w * 0.5
            for i, tr in tracks.items():
                px = tr['box'][0] + tr['box'][2] / 2
                if i not in seen and abs(px - cx) < bd:
                    best, bd = i, abs(px - cx)
            if best is None:
                best, next_id = next_id, next_id + 1
                tracks[best] = {'box': None, 'prev': None}
            tr = tracks[best]
            tr['box'] = (x, y, w, h)
            # Talking moves the mouth and jaw more than the eyes and brow;
            # nodding or shifting moves the whole head, both halves alike.
            # So: how much more the lower half changed than the upper.
            x0, x1 = max(0, x), min(W, x + w)
            ya, ym, yb = max(0, y), max(0, y + h // 2), min(H, y + h)
            patch = None
            if x1 > x0 and ym > ya and yb > ym:
                patch = (cv2.resize(gray[ym:yb, x0:x1], (32, 16)), cv2.resize(gray[ya:ym, x0:x1], (32, 16)))
            act = 0.0
            if patch is not None and tr['prev'] is not None:
                low = float(np.mean(cv2.absdiff(patch[0], tr['prev'][0])))
                up = float(np.mean(cv2.absdiff(patch[1], tr['prev'][1])))
                act = max(0.0, low - up)
            tr['prev'] = patch
            seen[best] = (cx, act, y + h / 2, h, w)
        samples.append((t, seen, frame if seen else None))
    return samples, tracks, W, H


def face_window(frame, W, H, cx, cy, fh, aspect, faces=3.2, least=0.5, eyes=1 / 3):
    """A crop (w, h, x, y) of the given aspect (w/h) around a face: about
    `faces` face heights tall but at least `least` of the frame, the face in
    its upper third, and kept inside the picture around the face (a call's
    tile, not the black around it), shrinking to fit it if need be."""
    import cv2
    g = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) > 18
    cx, cy = min(max(0, int(cx)), W - 1), min(max(0, int(cy)), H - 1)
    band = g[max(0, cy - 40):cy + 40, :].mean(axis=0) > 0.3
    stack = g[:, max(0, cx - 40):cx + 40].mean(axis=1) > 0.3

    def extent(m, at):
        a = b = at
        while a > 0 and m[a - 1]:
            a -= 1
        while b < len(m) - 1 and m[b + 1]:
            b += 1
        return a, b + 1
    bx0, bx1 = extent(band, cx)
    by0, by1 = extent(stack, cy)
    # A tile in a call can be a tenth of the frame wide (scribe, 2026-10-14);
    # under that, or on a dark frame, there is no picture box to keep to.
    # A face against a black wall lights up only itself: a "box" barely
    # bigger than the face is that, not a tile.
    if bx1 - bx0 < W * 0.1 or by1 - by0 < H * 0.15 or by1 - by0 < 1.4 * fh or bx1 - bx0 < 1.6 * fh:
        bx0, by0, bx1, by1 = 0, 0, W, H
    ch = min(H, max(H * least, fh * faces), by1 - by0)
    cw = ch * aspect
    if cw > bx1 - bx0:
        cw, ch = bx1 - bx0, (bx1 - bx0) / aspect
    cw, ch = int(cw) // 2 * 2, int(ch) // 2 * 2
    return cw, ch, int(min(max(bx0, cx - cw / 2), bx1 - cw)), int(min(max(by0, cy - ch * eyes), by1 - ch))


def turn_shots(video, t0, t1, turns, fps=5.0, place=None, places=None):
    """Speaker mode with labelled turns (diarize): each turn a still crop
    around the face of whoever speaks it, their voice matched to a face; a
    face not on screen in its turn gives way to the largest one that is, and
    a turn with no face is fitted."""
    import numpy as np
    samples, tracks, W, H = face_samples(video, t0, t1, fps)
    people = pool_people(samples, tracks, W)
    who = placed(people, places, W) if places else voice_faces(samples, people, turns, t0)
    by_x = sorted(range(len(people)), key=lambda k: people[k]['cx'])
    for spk, side in (place or {}).items():
        if by_x:
            who[spk] = by_x[0] if side == 'left' else by_x[-1]
    shots = []
    for a, b, spk in turns:
        run_ = [s for s in samples if a <= s[0] - t0 < b and s[1]]
        crop = None
        if run_:
            ids = people[who[spk]]['ids'] if spk in who else set()
            mine = [(s, i) for s in run_ for i in s[1] if i in ids]
            if not mine:
                big = max(run_[len(run_) // 2][1], key=lambda i: run_[len(run_) // 2][1][i][4])
                mine = [(s, big) for s in run_ if big in s[1]]
            mid = mine[len(mine) // 2]
            crop = face_window(mid[0][2], W, H, float(np.median([s[1][i][0] for s, i in mine])),
                               float(np.median([s[1][i][2] for s, i in mine])),
                               float(np.median([s[1][i][3] for s, i in mine])), 9 / 16)
        if shots and shots[-1][2] == crop:
            shots[-1][1] = b
        else:
            shots.append([a, b, crop])
    return shots


def speaker_shots(video, t0, t1, audio=None, fps=5.0, hold=1.0, lead=1.2, win=1.0):
    """The shots of a clip: [(start, end, crop or None)], times from t0, a
    crop (w, h, x, y) around whoever speaks, None where no face is seen (the
    clip then shows that stretch fitted). The speaker is the face whose mouth
    movement follows the loudness, held until another has clearly led for
    `hold` seconds; each shot is a still crop (face_window)."""
    import numpy as np
    samples, tracks, W, H = face_samples(video, t0, t1, fps)

    # Each face against its own usual: a bright, noisy, textured picture
    # "moves" more than a dark one even while its person listens, so raw
    # activity across faces is not comparable. Activity over the face's own
    # median, over the clip.
    base = {}
    for i in tracks:
        xs = sorted(s[1][i][1] for s in samples if i in s[1] and s[1][i][1] > 0)
        base[i] = max(xs[len(xs) // 2], 0.2) if xs else 1.0

    # The speaker's mouth moves in step with the sound; a listener who nods
    # moves too, but not with it. So the score is how well a face's activity
    # follows the loudness, over a window centred on the moment (the whole
    # clip is known), weighted by how active the face is for itself.
    loud = None
    if audio:
        raw = subprocess.run(['ffmpeg', '-loglevel', 'error', '-ss', f'{t0:.3f}', '-t', f'{t1 - t0:.3f}', '-i', audio,
                              '-ac', '1', '-ar', '8000', '-f', 's16le', '-'], capture_output=True).stdout
        pcm = np.frombuffer(raw, dtype=np.int16).astype(np.float32)
        hop = int(8000 / fps)
        loud = np.array([np.sqrt(np.mean(pcm[j:j + hop] ** 2)) if j + hop <= len(pcm) else 0.0
                         for j in range(0, len(pcm), hop)])

    def avg(i, k):
        t = samples[k][0]
        near = [(s[0], s[1][i][1]) for s in samples if abs(s[0] - t) <= win * 1.5 and i in s[1]]
        own = sum(v for _, v in near) / len(near) / base[i] if near else 0.0
        if loud is None or len(near) < 5:
            return own
        acts = np.array([v for _, v in near])
        snd = np.array([loud[min(len(loud) - 1, int((tt - t0) * fps))] for tt, _ in near])
        if acts.std() < 1e-6 or snd.std() < 1e-6:
            return 0.0
        r = float(np.corrcoef(acts, snd)[0, 1])
        return max(0.0, r) * (0.5 + min(own, 2.0))

    # Who, sample by sample, with hysteresis; None where nobody is seen.
    who, cur, since = [], None, None
    for k, (t, seen, _) in enumerate(samples):
        if not seen:
            who.append(None)
            since = None
            continue
        scores = {i: avg(i, k) for i in seen}
        top = max(scores, key=scores.get)
        if os.environ.get('REELCUT_DEBUG') and k % 5 == 0:
            print(f'    {t - t0:5.1f}s ' + '  '.join(f'face{i}@{int(seen[i][0])}:{scores[i]:.2f}' for i in sorted(seen)),
                  file=sys.stderr)
        if scores[top] < 0.15:
            top = max(seen, key=lambda i: seen[i][4])  # nobody clearly talking: the largest face
        if cur not in seen:
            cur, since = top, None
        elif top != cur and scores[top] > lead * max(scores[cur], 0.5):
            since = since if since is not None else t
            if t - since >= hold:
                cur, since = top, None
        else:
            since = None
        who.append(cur)

    # Runs of the same face (or of none) are shots; a crop from the middle frame.
    shots, k = [], 0
    while k < len(samples):
        j = k
        while j + 1 < len(samples) and who[j + 1] == who[k]:
            j += 1
        a = samples[k][0] - t0
        b = (samples[j + 1][0] if j + 1 < len(samples) else t1) - t0
        crop = None
        if who[k] is not None:
            i = who[k]
            run_ = [s for s in samples[k:j + 1] if i in s[1]]
            mid = run_[len(run_) // 2]
            cx = float(np.median([s[1][i][0] for s in run_]))
            cy = float(np.median([s[1][i][2] for s in run_]))
            fh = float(np.median([s[1][i][3] for s in run_]))
            crop = face_window(mid[2], W, H, cx, cy, fh, 9 / 16)
        if shots and (b - a < 0.6 or shots[-1][2] == crop):
            shots[-1][1] = b  # too short to be a shot, or the same one again
        else:
            shots.append([a, b, crop])
        k = j + 1
    if shots:
        shots[0][0], shots[-1][1] = 0.0, t1 - t0
    return shots or [[0.0, t1 - t0, None]]


def pool_people(samples, tracks, W):
    """Tracks pooled into people: a face whose track was lost and found again,
    or seen in two runs, is one person where its positions agree. Each is
    {'cx', 'ids', 'seen': [(sample, track)]}, the most seen first."""
    import numpy as np
    people = []
    for i in tracks:
        seen = [s for s in samples if i in s[1]]
        if not seen:
            continue
        cx = float(np.median([s[1][i][0] for s in seen]))
        for p in people:
            if abs(p['cx'] - cx) < W * 0.08:
                p['seen'] += [(s, i) for s in seen]
                p['ids'].add(i)
                break
        else:
            people.append({'cx': cx, 'ids': {i}, 'seen': [(s, i) for s in seen]})
    people.sort(key=lambda p: -len(p['seen']))
    return people


def clip_turns(words, t0, t1, least=1.0):
    """Who speaks when within a clip, from labelled words (diarize):
    [[start, end, speaker]] from t0, covering the clip, turns shorter than
    `least` seconds folded into the one before."""
    runs = []
    for x in words:
        if len(x) < 4:
            continue
        a, b = x[0] - t0, x[1] - t0
        if runs and runs[-1][2] == x[3]:
            runs[-1][1] = b
        else:
            runs.append([a, b, x[3]])
    if not runs:
        return None
    for k in range(len(runs) - 1):
        runs[k][1] = runs[k + 1][0]
    runs[0][0], runs[-1][1] = 0.0, t1 - t0
    out = []
    for r in runs:
        if out and (r[1] - r[0] < least or out[-1][2] == r[2]):
            out[-1][1] = r[1]
        else:
            out.append(r)
    # A sliver of another voice at the very start is not a turn either; a
    # little more lenient than mid-clip (scribe's clip 2 opened on exactly 1 s).
    if len(out) > 1 and out[0][1] - out[0][0] < least * 1.5:
        out[1][0] = 0.0
        out.pop(0)
    return out


def voice_faces(samples, people, turns, t0):
    """Which person each voice is: the one whose mouth moves most, against
    their own usual, while that voice speaks. {speaker: index in people}."""
    score = {}
    for k, p in enumerate(people):
        allv = [s[1][i][1] for s, i in p['seen']]
        usual = (sum(allv) / len(allv)) if allv else 0
        for spk in {t[2] for t in turns}:
            during = [s[1][i][1] for s, i in p['seen']
                      if any(t[2] == spk and t[0] <= s[0] - t0 < t[1] for t in turns)]
            if during and usual > 0:
                score[(spk, k)] = sum(during) / len(during) / usual
    if os.environ.get('REELCUT_DEBUG'):
        print('    voice to face: ' + ', '.join(f'{spk}->person{k} {v:.2f}' for (spk, k), v in sorted(score.items())),
              file=sys.stderr)
    out, taken = {}, set()
    for (spk, k), v in sorted(score.items(), key=lambda kv: -kv[1]):
        if spk not in out and k not in taken:
            out[spk], taken = k, taken | {k}
    return out


def speaker_places(video, words, t0, t1):
    """Where each voice sits in the picture around a clip, {speaker: x}, and
    the stretch it was learnt on. A clip where only one person talks cannot
    tell faces apart by who moves with which voice, so the match is made on
    the stretch around the clip, widened until two voices have each spoken
    for a while: around the clip rather than anywhere in the recording,
    because a recording can change layouts (full frame, then a call's tiles)
    and a place learnt in one layout is wrong in another."""
    labelled = [x for x in words if len(x) > 3]
    if not labelled:
        return {}, (t0, t1)
    mid = (t0 + t1) / 2
    a, b = t0, t1
    for pad in (30, 60, 120, 240, 480):
        a, b = max(0.0, mid - pad), mid + pad
        talk = {}
        for x in labelled:
            if a <= x[0] <= b:
                talk[x[3]] = talk.get(x[3], 0) + x[1] - x[0]
        if sum(1 for v in talk.values() if v >= 10) >= 2:
            break
    stretch = [x for x in labelled if a <= x[0] <= b]
    turns = clip_turns(stretch, a, b) or []
    if len({t[2] for t in turns}) < 2:
        return {}, (a, b)
    samples, tracks, W, H = face_samples(video, a, b, 2.0)
    people = pool_people(samples, tracks, W)
    who = voice_faces(samples, people, turns, a)
    places = {spk: people[k]['cx'] for spk, k in who.items()}
    if os.environ.get('REELCUT_DEBUG'):
        print(f'    voices placed from {hms(a)}-{hms(b)}: ' +
              ', '.join(f'{spk} at x={int(x)}' for spk, x in sorted(places.items())), file=sys.stderr)
    return places, (a, b)


def placed(people, places, W):
    """{speaker: index in people}, by where each voice sits; one person per
    voice, the nearer one keeping it."""
    out, dist = {}, {}
    for spk, x in places.items():
        near = min(range(len(people)), key=lambda k: abs(people[k]['cx'] - x), default=None)
        if near is None or abs(people[near]['cx'] - x) >= W * 0.15:
            continue
        d = abs(people[near]['cx'] - x)
        other = next((o for o, k in out.items() if k == near), None)
        if other is None or d < dist[other]:
            if other is not None:
                del out[other]
            out[spk], dist[spk] = near, d
    return out


def stack_layout(video, t0, t1, fps=3.0, turns=None, place=None, places=None):
    """Two people, one above the other (--frame stack): the two faces seen
    most in the clip, the one further left on top, each a 1080x960 crop
    around them. None when the clip does not show two people for most of it.
    No guessing who speaks: both are always on screen."""
    import numpy as np
    samples, tracks, W, H = face_samples(video, t0, t1, fps)
    people = pool_people(samples, tracks, W)
    if len(people) < 2 or len(people[1]['seen']) < 0.3 * len(samples):
        return None
    pair = sorted(people[:2], key=lambda p: p['cx'])
    crops = []
    for p in pair:
        seen = p['seen']
        cy = float(np.median([s[1][i][2] for s, i in seen]))
        fh = float(np.median([s[1][i][3] for s, i in seen]))
        frame = seen[len(seen) // 2][0][2]
        # Head and shoulders with room above: a small call tile zoomed to
        # two face heights filled the half with a head and cut its top.
        crops.append(face_window(frame, W, H, p['cx'], cy, fh, 1080 / 960, faces=2.8, least=0.3, eyes=0.42))
    stacked = ('stack', crops[0], crops[1])
    # Stacked where both are on screen; where the recording shows one person
    # (a full-frame shot between call layouts), a crop around them; where
    # nobody, fitted. Runs of the same, joined.
    ids = [{i for s, i in p['seen']} for p in pair]
    segs = []
    for s in samples:
        both = all(any(i in s[1] for i in ids_) for ids_ in ids)
        if both:
            look = stacked
        elif s[1]:
            i = max(s[1], key=lambda i: s[1][i][4])
            look = ('one', i)
        else:
            look = None
        a = s[0] - t0
        if segs and segs[-1][2] == look:
            segs[-1][1] = a
        else:
            segs.append([a, a, look])
    out = []
    for k, (a, b, look) in enumerate(segs):
        b = segs[k + 1][0] if k + 1 < len(segs) else t1 - t0
        if out and b - a < 0.6:
            out[-1][1] = b  # too short to be a shot
            continue
        if look and look[0] == 'one':
            i = look[1]
            run_ = [s for s in samples if a <= s[0] - t0 <= b and i in s[1]]
            mid = run_[len(run_) // 2]
            look = face_window(mid[2], W, H, float(np.median([s[1][i][0] for s in run_])),
                               float(np.median([s[1][i][2] for s in run_])),
                               float(np.median([s[1][i][3] for s in run_])), 9 / 16)
        if out and out[-1][2] == look:
            out[-1][1] = b
        else:
            out.append([a, b, look])
    out[0][0], out[-1][1] = 0.0, t1 - t0
    if not turns:
        return out
    # Who speaks, on top or below: their voice matched to a face (or as the
    # person named them, left/right), and the listener's half dimmed for the
    # length of each turn.
    who = placed(pair, places, W) if places else voice_faces(samples, pair, turns, t0)
    for spk, side in (place or {}).items():
        who[spk] = 0 if side == 'left' else 1
    split = []
    for a, b, look in out:
        if not (look and look[0] == 'stack'):
            split.append([a, b, look])
            continue
        for ta, tb, spk in turns:
            lo, hi = max(a, ta), min(b, tb)
            if hi - lo > 0.05:
                split.append([lo, hi, look + (who.get(spk),)])
    return split


_ENCODER = None


def h264():
    """x264 where ffmpeg has it; else OpenH264, which Fedora's ffmpeg-free
    carries (scribe, 2026-10-14) at a fixed bitrate."""
    global _ENCODER
    if _ENCODER is None:
        enc = subprocess.run(['ffmpeg', '-hide_banner', '-encoders'], capture_output=True, text=True).stdout
        if ' libx264 ' in enc:
            _ENCODER = ['-c:v', 'libx264', '-preset', 'medium', '-crf', '20']
        elif ' libopenh264 ' in enc:
            _ENCODER = ['-c:v', 'libopenh264', '-b:v', '6M']
        else:
            sys.exit('reelcut: ffmpeg here has no H.264 encoder (libx264 or libopenh264)')
    return _ENCODER


def cut(a):
    words = json.load(open(os.path.join(a.dir, 'words.json')))
    video = find(a.dir, 'video.*')
    audio = find(a.dir, 'audio.*') if glob.glob(os.path.join(a.dir, 'audio.*')) else video
    fixes = dict(f.split('=', 1) for f in a.fix)
    os.makedirs(a.out, exist_ok=True)
    w, h = (int(x) for x in subprocess.check_output(
        ['ffprobe', '-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height',
         '-of', 'csv=p=0:s=x', video], text=True).strip().split('x'))
    # A portrait recording is scaled to 1080x1920 as it is. A landscape one is,
    # by default, fitted across the width over a blurred, darkened copy of
    # itself filling the frame ("fit"): nothing is cut off, a speaker or a
    # slide at the edge stays in. "crop" cuts 9:16 out of its middle instead.
    mode = a.frame if a.frame != 'auto' else ('fit' if w > h else 'crop')
    if mode in ('speaker', 'stack') and w <= h:
        mode = 'crop'  # a portrait recording is already framed
    if w <= h:
        frame = 'scale=1080:1920'
    elif mode == 'fit':
        frame = ('split[bg][fg];'
                 '[bg]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,'
                 'gblur=sigma=40,eq=brightness=-0.12[bg];'
                 '[fg]scale=1080:-2[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2')
    else:
        frame = 'scale=-2:1920,crop=1080:1920'
    # The hook above the picture when it is a band in the middle; over its
    # lower part when it fills the frame.
    band = w > h and mode == 'fit'
    hook_margin = a.hook_margin if a.hook_margin is not None else (470 if band else 1190)
    speaker = w > h and mode == 'speaker'
    stack = w > h and mode == 'stack'

    caption_margin = a.caption_margin if a.caption_margin is not None else 470
    # Names for the speakers diarize found ("A=Petty,B=Václav"), and where
    # they sit when the voices should not be matched to faces by guess
    # ("A=Petty@left").
    names, place = {}, {}
    for item in filter(None, (x.strip() for x in (a.speakers or '').split(','))):
        letter, _, rest = item.partition('=')
        name, _, side = rest.partition('@')
        names[letter.strip().upper()] = name.strip()
        if side.strip() in ('left', 'right'):
            place[letter.strip().upper()] = side.strip()
    labelled = any(len(x) > 3 for x in words)
    places, learnt = None, (0, 0)  # where each voice sits, and the stretch that says so

    def esc(s):
        for k, v in fixes.items():
            s = re.sub(r'\b' + re.escape(k) + r'\b', v, s)
        s = re.sub(r'([A-Za-z])(\d)', r'\1 \2', s)  # "like60" -> "like 60"
        return s.replace('\\', '').replace('{', '(').replace('}', ')')

    only = {int(x) for x in a.only.split(',') if x.strip()} if a.only else None
    for n, parts in enumerate(clip_lines(a.clips), 1):
        if only and int(re.sub(r'(?i)^clip\s*', '', parts[0])) not in only:
            continue
        start_s = secs(re.sub(r'(?i)^start\s*', '', parts[1]))
        end_s = secs(re.sub(r'(?i)^end\s*', '', parts[2]))
        hook = parts[4]
        until = re.sub(r'(?i)^until\s*', '', parts[5]).strip().lower() if len(parts) > 5 else ''
        i0 = next(i for i, x in enumerate(words) if x[0] >= start_s - 0.05)
        j = next(i for i, x in enumerate(words) if x[0] >= end_s - 0.05)
        norm = lambda s: re.sub(r'[^\w%]', '', s.lower())
        if until:  # the first word matching LASTWORD at or after END
            while j < len(words) - 1 and norm(words[j][2]) != norm(until):
                j += 1
        else:  # the end of the sentence starting at END
            while j < len(words) - 1 and not is_end(words[j][2]):
                j += 1
        # A breath before the first word and after the last (--lead, --tail),
        # faded in and out, so a clip does not start or stop on a hard edge.
        t0, t1 = max(0.0, words[i0][0] - a.lead), words[j][1] + a.tail
        ws, capital = [], False
        for x in words[i0:j + 1]:
            if not a.keep_fillers and norm(x[2]) in FILLERS:
                capital = capital or x[2][:1].isupper()
                continue
            if capital:
                x = [x[0], x[1], x[2][:1].upper() + x[2][1:]]
                capital = False
            ws.append(x)
        groups, g = [], []
        for x in ws:
            g.append(x)
            if len(g) == 4 or x[2].endswith(('.', ',', '?', '!', ';', ':')):
                groups.append(g)
                g = []
        if g:
            groups.append(g)
        ev = [f'Dialogue: 1,{ts(0)},{ts(3.5)},Hook,,0,0,0,,{esc(hook.upper())}']
        for gi, g in enumerate(groups):
            g_end = groups[gi + 1][0][0] if gi + 1 < len(groups) else g[-1][1] + 0.3
            for wi, x in enumerate(g):
                s = x[0] - t0
                e = (g[wi + 1][0] if wi + 1 < len(g) else g_end) - t0
                text = ' '.join('{\\c' + (SAYING if y is x else speaker_colour(y[3] if len(y) > 3 else None)) + '}'
                                + esc(y[2]) for y in g)
                ev.append(f'Dialogue: 0,{ts(s)},{ts(max(e, s + 0.05))},Cap,,0,0,0,,{text}')
        slug = re.sub(r'[^a-z0-9]+', '-', hook.lower()).strip('-')[:40]
        base = os.path.join(a.out, f'{n:02d}-{slug}')
        dur = t1 - t0
        fd = min(a.fade, dur / 4)
        finish = f"ass={base}.ass,fade=in:st=0:d={fd:.2f},fade=out:st={dur - fd:.2f}:d={fd:.2f}"
        hv, cv = hook_margin, caption_margin
        turns = clip_turns(words[i0:j + 1], t0, t1) if labelled else None
        # Where each voice sits: as the person said (@left/@right), which is
        # certain and free; else matched from the stretch around the clip,
        # which is slower and can be wrong when faces are dark or small.
        told = turns and all(t[2] in place for t in turns)
        if turns and (stack or speaker) and not told and not (places and learnt[0] <= t0 and t1 <= learnt[1]):
            places, learnt = speaker_places(video, words, t0, t1)
        shots = stack_layout(video, t0, t1, turns=turns, place=place, places=places) if stack else None
        if stack and shots is None:
            print('  not two people on screen for most of it: following the speaker instead')
        if shots:
            # Two people, one above the other: the text on the seam between
            # them, the hook just above the captions, off both faces.
            if a.hook_margin is None:
                hv = 820
            if a.caption_margin is None:
                cv = 860
        if speaker or stack:
            # Each shot with its own look (a crop, two stacked, or fitted
            # where no face is seen), joined, then the captions over all.
            if not shots:
                shots = (turn_shots(video, t0, t1, turns, place=place, places=places) if turns
                         else speaker_shots(video, t0, t1, audio))
                if a.hook_margin is None and shots[0][2] is None:
                    hv = 470  # the first shot is a band: the hook above it
            parts = []
            for k, (sa, sb, crop) in enumerate(shots):
                head = f'[0:v]trim=start={sa:.3f}:end={sb:.3f},setpts=PTS-STARTPTS'
                if crop and crop[0] == 'stack':
                    (tw, th, tx, ty), (bw, bh, bx, by) = crop[1], crop[2]
                    active = crop[3] if len(crop) > 3 else None
                    # The one listening, a little dimmer, while the other speaks.
                    dim = ',eq=brightness=-0.08:saturation=0.8'
                    td = dim if active == 1 else ''
                    bd = dim if active == 0 else ''
                    parts.append(f'{head},split[t{k}][b{k}];[t{k}]crop={tw}:{th}:{tx}:{ty},scale=1080:960{td},setsar=1[t{k}c];'
                                 f'[b{k}]crop={bw}:{bh}:{bx}:{by},scale=1080:960{bd},setsar=1[b{k}c];'
                                 f'[t{k}c][b{k}c]vstack=2,setsar=1[s{k}]')
                    continue
                look = (f'crop={crop[0]}:{crop[1]}:{crop[2]}:{crop[3]},scale=1080:1920' if crop
                        else FIT.format(k=k))
                parts.append(f'{head},{look},setsar=1[s{k}]')
            graph = (';'.join(parts) + ';' + ''.join(f'[s{k}]' for k in range(len(shots))) +
                     f'concat=n={len(shots)}:v=1:a=0,{finish}[v]')
            video_args = ['-filter_complex', graph, '-map', '[v]', '-map', '1:a']
            print(f'  {len(shots)} shots: ' + ', '.join(
                f"{sa:.1f}-{sb:.1f} " + ('fit' if c is None else 'stacked' if c[0] == 'stack' else f'{c[0]}x{c[1]}')
                for sa, sb, c in shots))
        else:
            video_args = ['-map', '0:v', '-map', '1:a', '-vf', f'{frame},{finish}']
        if names and turns:
            # Who speaks, named in their colour, at the start of each turn.
            for ta, tb, spk in turns:
                ta = max(ta, 3.5)  # not under the hook, which holds the first 3.5 s
                if spk in names and tb - ta > 0.8:
                    ev.append(f'Dialogue: 2,{ts(ta)},{ts(min(tb, ta + 2.0))},Name,,0,0,0,,'
                              f'{{\\c{speaker_colour(spk)}}}{esc(names[spk].upper())}')
        open(base + '.ass', 'w').write(HEAD.format(cap_v=cv, hook_v=hv, name_v=cv + 95) + '\n'.join(ev) + '\n')
        run('ffmpeg', '-loglevel', 'error', '-y', '-ss', f'{t0:.2f}', '-i', video, '-ss', f'{t0:.2f}', '-i', audio,
            '-t', f'{dur:.2f}', *video_args,
            '-af', f'afade=in:st=0:d={fd:.2f},afade=out:st={dur - fd:.2f}:d={fd:.2f}',
            *h264(), '-pix_fmt', 'yuv420p',
            '-c:a', 'aac', '-b:a', '160k', '-movflags', '+faststart', base + '.mp4')
        if a.intro or a.outro:
            with_cards(base + '.mp4', a.intro, a.outro, a.card, a.fade)
        last = ' '.join(x[2] for x in words[max(i0, j - 3):j + 1])
        print(f'{base}.mp4  {dur:.1f}s  {ts(t0)} → {ts(t1)}  …{last}')


def with_cards(clip, intro, outro, seconds, fade):
    """An opening and a closing card around a reel: an image (a logo, a QR
    code, a URL) fitted on black, faded in from black and out to it, held
    `seconds`, silent; the reel between them as it was."""
    # Card, clip, card, each with picture and sound, joined.
    inputs, chains, labels = [], [], []
    idx = 0
    fd = min(fade if fade > 0 else 0.4, seconds / 3)

    def card(img):
        nonlocal idx
        inputs.extend(['-loop', '1', '-t', f'{seconds:.2f}', '-i', img])
        chains.append(f'[{idx}:v]scale=1080:1920:force_original_aspect_ratio=decrease,'
                      f'pad=1080:1920:(ow-iw)/2:(oh-ih)/2:black,setsar=1,fps=30,format=yuv420p,'
                      f'fade=in:st=0:d={fd:.2f},fade=out:st={seconds - fd:.2f}:d={fd:.2f}[v{idx}];'
                      f'anullsrc=r=48000:cl=stereo,atrim=0:{seconds:.2f}[a{idx}]')
        labels.append(f'[v{idx}][a{idx}]')
        idx += 1
    if intro:
        card(intro)
    inputs.extend(['-i', clip])
    chains.append(f'[{idx}:v]fps=30,format=yuv420p,setsar=1[v{idx}];'
                  f'[{idx}:a]aresample=48000,aformat=channel_layouts=stereo[a{idx}]')
    labels.append(f'[v{idx}][a{idx}]')
    idx += 1
    if outro:
        card(outro)
    graph = ';'.join(chains) + ';' + ''.join(labels) + f'concat=n={len(labels)}:v=1:a=1[v][a]'
    tmp = clip + '.cards.mp4'
    run('ffmpeg', '-loglevel', 'error', '-y', *inputs, '-filter_complex', graph, '-map', '[v]', '-map', '[a]',
        *h264(), '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '160k', '-movflags', '+faststart', tmp)
    os.replace(tmp, clip)


# --- page --------------------------------------------------------------------

def page(a):
    clips = sorted(f for f in os.listdir(a.out) if f.endswith('.mp4'))
    title = lambda f: re.sub(r'^\d+-', '', f[:-4]).replace('-', ' ').capitalize()
    cards = '\n'.join(f'<figure><video src="{html.escape(f)}" controls preload="metadata" playsinline></video>'
                      f'<figcaption><b>{html.escape(title(f))}</b> <a href="{html.escape(f)}" download>download</a>'
                      f'</figcaption></figure>' for f in clips)
    t = html.escape(a.title)
    open(os.path.join(a.out, 'index.html'), 'w').write(f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{t}</title><style>
:root{{--bg:#f6f5f2;--fg:#1d1d1b;--muted:#6b6a66;--card:#fff;--line:#e3e1dc}}
@media (prefers-color-scheme:dark){{:root{{--bg:#121211;--fg:#ecebe7;--muted:#9a9893;--card:#1c1c1a;--line:#2c2c29}}}}
body{{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,sans-serif}}
main{{max-width:1200px;margin:0 auto;padding:24px 16px 48px}} h1{{font-size:1.5rem;margin:0 0 20px}}
.grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}}
figure{{margin:0;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden}}
video{{display:block;width:100%;aspect-ratio:9/16;background:#000}}
figcaption{{padding:10px 12px;font-size:.92rem}} figcaption a{{float:right;color:var(--muted)}}
</style></head><body><main><h1>{t}</h1><div class="grid">
{cards}
</div></main></body></html>
''')
    print(os.path.join(a.out, 'index.html'))


def main():
    ap = argparse.ArgumentParser(prog='reelcut', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('fetch'); s.add_argument('url'); s.add_argument('dir'); s.set_defaults(fn=fetch)
    s = sub.add_parser('transcribe'); s.add_argument('dir')
    s.add_argument('--threads', type=int, default=4, help='per piece (default 4)')
    s.add_argument('--jobs', type=int, default=0, help='pieces at once (default: cores / threads)')
    s.set_defaults(fn=transcribe)
    s = sub.add_parser('diarize', help='who speaks when: a speaker for every word; before, after or alongside transcribe')
    s.add_argument('dir')
    s.add_argument('--speakers', type=int, default=0, help='how many people talk (default: counted from the voices)')
    s.add_argument('--threshold', type=float, default=0.9,
                   help='without --speakers: how unlike two voices must be to count as two people (lower: more people)')
    s.add_argument('--threads', type=int, default=0)
    s.set_defaults(fn=diarize)
    s = sub.add_parser('prompt'); s.add_argument('dir')
    s.add_argument('-n', type=int, default=6, help='how many clips to propose (more than you will cut, to choose from)')
    s.add_argument('--brief', default='', help='what you are looking for: topics, people, tone, keywords')
    s.add_argument('--brief-file', default='', help='the same, from a file')
    s.add_argument('--min', type=int, default=20); s.add_argument('--max', type=int, default=55); s.set_defaults(fn=prompt)
    s = sub.add_parser('cut'); s.add_argument('dir'); s.add_argument('clips'); s.add_argument('out')
    s.add_argument('--only', default='', metavar='1,3,5', help='cut only these clips of the list, by their number')
    s.add_argument('--lead', type=float, default=0.25, help='seconds before the first word (default 0.25)')
    s.add_argument('--tail', type=float, default=0.4, help='seconds after the last word (default 0.4)')
    s.add_argument('--fade', type=float, default=0.3, help='fade in and out, picture and sound, in seconds (default 0.3)')
    s.add_argument('--intro', default='', metavar='IMAGE', help='an opening card: fades in from black before the clip')
    s.add_argument('--outro', default='', metavar='IMAGE', help='a closing card after the clip (a QR code, a URL, a logo)')
    s.add_argument('--card', type=float, default=2.0, help='seconds each card shows (default 2)')
    s.add_argument('--fix', action='append', default=[], metavar='HEARD=MEANT', help='fix a misheard word in the captions')
    s.add_argument('--keep-fillers', action='store_true', help='keep um and uh in the captions')
    s.add_argument('--speakers', default='', metavar='A=NAME[@left|@right],…',
                   help='after diarize: name the speakers (shown as they start to speak, captions in their colour); '
                        '@left/@right says where they sit instead of matching voices to faces')
    s.add_argument('--frame', choices=['auto', 'fit', 'crop', 'speaker', 'stack'], default='auto',
                   help='a landscape video: fit it across the width over a blurred copy (auto, fit), crop 9:16 from its '
                        'middle (crop), follow whoever speaks (speaker), or two people one above the other '
                        '(stack); speaker and stack are experimental and need OpenCV')
    s.add_argument('--caption-margin', type=int, default=None, help='captions, px from the bottom of 1920 (default 470)')
    s.add_argument('--hook-margin', type=int, default=None, help='hook title, px from the top of 1920 (default: above a fitted picture, else 1190)')
    s.set_defaults(fn=cut)
    s = sub.add_parser('page'); s.add_argument('out'); s.add_argument('--title', default='Reels'); s.set_defaults(fn=page)
    a = ap.parse_args()
    a.fn(a)


if __name__ == '__main__':
    main()
